# Copy to .env to configure. Both are optional -- the app works with
# no API key at all, using the built-in mock LLM provider.

PORT=4100

# Set to "false" to use the real Anthropic API instead of the mock provider.
USE_MOCK_LLM=true

# Only needed if USE_MOCK_LLM=false
ANTHROPIC_API_KEY=

# Multi-model routing (FR-9.7). Economy tier is used for simpler/shorter tasks.
LLM_MODEL_PRIMARY=claude-sonnet-4-6
LLM_MODEL_ECONOMY=claude-haiku-4-5

# Max characters sent to the LLM per request (~4 chars ≈ 1 token). Oversized document
# inputs are head/tail-truncated before submission.
LLM_MAX_INPUT_CHARS=24000

# Default script language when codegen does not specify one (one language per LLM call).
LLM_DEFAULT_SCRIPT_LANGUAGE=typescript

# 32-byte hex key used to encrypt integration tokens at rest (FR-8.4). If unset, a dev-only
# key is auto-generated at server/.dev-encryption-key (gitignored) -- fine for local dev,
# not for anything real. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=

# Only needed to send the Allure report by email (POST /api/allure/send-email). Any SMTP
# provider works (Gmail app password, SendGrid, Mailtrap, etc). Left unset, the endpoint
# returns a clear 503 instead of silently failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
